# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# Local only (Vite reads this in dev; the deploy script sets it for prod builds):
VITE_CONVEX_URL=https://<deployment>.convex.cloud
#
# Everything below lives on the Convex deployment, NOT in this file:
#   npx convex env set OPENAI_API_KEY sk-...
#   npx convex env set FIRECRAWL_API_KEY fc-...
#   npx convex env set FIRECRAWL_WEBHOOK_SECRET whsec-...   (optional)
#   npx convex env set AGENTMAIL_API_KEY ...
#   npx convex env set AGENTMAIL_WEBHOOK_SECRET whsec_...
# Listed here so a fresh clone knows what to provision.
OPENAI_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_WEBHOOK_SECRET=
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
